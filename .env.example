# BizLedger environment template.
#
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# values. The existing `.gitignore` already ignores `.env*` files.

# Prisma / PostgreSQL connection strings (Supabase).
# DATABASE_URL is the pooled runtime connection (pgbouncer, port 6543).
# DIRECT_URL is the direct connection used for migrations (port 5432).
DATABASE_URL=
DIRECT_URL=

# Better Auth.
# Generate a secret with: npx @better-auth/cli generate-secret  (>=32 chars)
BETTER_AUTH_SECRET=

# Base URL of this app (the origin users see). Better Auth builds every absolute
# URL from it — password-reset and email-verification links in transactional
# mail, the Google OAuth callback, and cookie settings. Local dev uses the
# localhost origin below. PRODUCTION: set the REAL, resolvable origin (e.g.
# https://app.yourdomain.com) before building. A fake/placeholder host such as
# app.bizledger.test is NOT resolvable and makes emailed reset/verify links fail
# with DNS_PROBE_FINISHED_NXDOMAIN — never ship a placeholder here.
# MUST start with https:// in staging and production: this is what enables
# secure auth cookies (useSecureCookies) and the HSTS/CSP-Report-Only headers.
BETTER_AUTH_URL=http://localhost:3000

# Trusted reverse-proxy IPs/CIDRs used to resolve the REAL client IP for rate
# limiting (comma-separated, e.g. "10.0.0.4, 192.0.2.10/32").
#   * Set ONLY the actual addresses/subnets of your TLS-terminating
#     proxy / load balancer / edge.
#   * Leave EMPTY in local dev (no proxy) and for any direct-exposure box.
#   * PRODUCTION: if this is empty the app REFUSES to trust any client-supplied
#     X-Forwarded-For header, so per-IP rate limiting degrades to a single
#     shared per-path bucket. Set it for correct per-IP limits (DEPLOYMENT.md §6.1).
TRUSTED_PROXIES=

# Production cross-origin allowlist (comma-separated absolute origins).
# The customer app itself is always allowed (its own origin). Needed ONLY if a
# SEPARATE deployed cross-origin client must call /api/auth/* with cookies
# (e.g. the standalone admin console).
#
# ADMIN_PRODUCTION_ORIGIN = NEEDS OPERATOR INPUT.
# The admin console's production hostname and exposure policy are undecided, so
# do NOT put a guessed value here. Add the real origin (e.g.
# "https://<decided-admin-host>") only after it has been chosen.
# Wildcard ("*") entries are always rejected. Leave empty for same-origin only.
TRUSTED_ORIGINS=

# Google OAuth (OPTIONAL — Google sign-in is disabled when these are empty).
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console and register, for EACH origin that runs this app, an authorized
# redirect URI of the form:
#   <APP_ORIGIN>/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google for local dev
#      https://bizledger.example.com/api/auth/callback/google for production
# GOOGLE_CLIENT_ID is public by nature; GOOGLE_CLIENT_SECRET is server-only.
# NEVER expose GOOGLE_CLIENT_SECRET in a NEXT_PUBLIC_* variable — the client
# bundle only receives PUBLIC flag NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true, which
# simply shows/hides the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public (client-bundle) switch for the "Continue with Google" button.
# Set to true ONLY alongside real GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=

# Razorpay (server-only; NEVER commit real values).
# Test Mode credentials come from dashboard.razorpay.com -> Test Mode -> API Keys.
# RAZORPAY_WEBHOOK_SECRET is the webhook signing secret for Phase 4C+ webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional mail via Resend (OPTIONAL). Password reset / email-verification
# mail is SKIPPED (with a one-time server-side warning) when mail is not
# configured — nothing sensitive is ever logged (see src/lib/auth/mail.ts).
# Get a key at https://resend.com/api-keys. The domain in MAIL_FROM MUST be
# verified in Resend (add domain -> DNS records -> verify) before delivery works.
RESEND_API_KEY=
# Sender for all transactional mail. MUST use a domain verified in Resend.
MAIL_FROM=no-reply@bizledger.io
# Resend webhook signing secret (Standard Webhooks / Svix). From the Resend
# dashboard -> Webhooks -> the signing secret of the webhook that targets
#   POST <RESEND_WEBHOOK_BASE_URL>/api/webhooks/resend
# WITHOUT this, /api/webhooks/resend answers 503 (Resend retries until set).
RESEND_WEBHOOK_SECRET=

# Public base URL that Resend uses to reach this app's webhook endpoint.
# Must be the current VS Code forwarded HTTPS URL (or the production host) —
# set it to the URL VS Code shows for the forwarded port, e.g.
#   RESEND_WEBHOOK_BASE_URL=https://abc-3000.incl.devtunnels.ms
# Do NOT include the webhook path itself: the app appends /api/webhooks/resend,
# so the endpoint becomes https://abc-3000.incl.devtunnels.ms/api/webhooks/resend.
# It changes whenever the forwarded URL changes — update it only in .env.local.
# Server configuration only (never NEXT_PUBLIC_); getResendWebhookUrl() fails
# loudly instead of building an invalid endpoint when this is missing.
RESEND_WEBHOOK_BASE_URL=https://YOUR-DEV-TUNNEL-URL

# Force Better Auth's DB rate limiter on in non-production (staging soak tests
# / throttling verification). Leave unset in normal dev/test.
AUTH_RATE_LIMIT_FORCE=

# NOTE — reset protection is always on (independent of AUTH_RATE_LIMIT_FORCE):
#   * per-EMAIL reset budget: max 5 requests per address per 300s (keyed by a
#     SHA-256 digest of the normalized email in the rate_limit table),
#   * a new reset request invalidates all earlier unused reset links for that
#     user (only the newest token stays valid),
#   * a successful reset revokes the user's existing sessions.
# These never reveal whether an email has an account (identical 200/429
# responses) and never log tokens, emails, passwords, or URLs.