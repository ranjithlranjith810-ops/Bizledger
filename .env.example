# BizLedger environment template.
#
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# values. The existing `.gitignore` already ignores `.env*` files.

# Prisma / PostgreSQL connection strings (Supabase).
# DATABASE_URL is the pooled runtime connection (pgbouncer, port 6543).
# DIRECT_URL is the direct connection used for migrations (port 5432).
DATABASE_URL=
DIRECT_URL=

# Better Auth.
# Generate a secret with: npx @better-auth/cli generate-secret  (>=32 chars)
BETTER_AUTH_SECRET=

# Base URL of this app, used by Better Auth to build absolute URLs.
BETTER_AUTH_URL=http://localhost:3000